# Copia questo file in .env.local e compila i valori. Qui ci sono solo nomi e valori finti (brief 12.3).

# Indirizzo pubblico del sito, senza barra finale. Serve per link di accesso, anteprime social e sitemap.
SITE_URL=http://localhost:3000

# PostgreSQL in regione UE (Supabase, Neon, Render...). Se manca, in locale parte il database
# incorporato nella cartella .data/ con l'edizione di esempio: comodo per sviluppare, non per la produzione.
DATABASE_URL=

# Segreto lungo e casuale (almeno 32 caratteri): firma i link di accesso e le sessioni del pannello.
AUTH_SECRET=cambia-questo-valore-con-una-stringa-lunga-e-casuale

# Email transazionale (Resend). Senza chiave i messaggi finiscono in .data/outbox.log e nel log del server.
EMAIL_API_KEY=
EMAIL_FROM="SMG Summer Cup <noreply@example.org>"

# Chi riceve gli avvisi di nuova iscrizione e le richieste di rimozione.
NOTIFY_EMAIL=organizzatore@example.org

# Email del titolare: `npm run db:setup` crea con questa il primo accesso al pannello.
OWNER_EMAIL=organizzatore@example.org

# Gettone per /api/revalidate e /api/cron/retention (rigenerazione pagine e pulizia programmata).
REVALIDATE_TOKEN=un-altro-valore-lungo-e-casuale

# Cartella delle foto caricate (deve stare su un disco persistente, fuori dalla cartella pubblica).
MEDIA_DIR=

# Solo fuori produzione: stato iniziale dell'edizione di esempio (iscrizioni | programma | live | conclusa).
SMG_SEED_PHASE=live
